{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "openkos/platform",
    "version": "0.1.0",
    "description": "The OpenKOS platform and plugin SDK.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OpenKOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --compact",
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenKOS\\Platform\\PlatformServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
